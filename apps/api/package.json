{
  "name": "@crm/api",
  "version": "1.0.0",
  "description": "Express API for CRM platform",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.js",
    "db:migrate": "cd ../../prisma/postgres && npx prisma migrate dev",
    "db:migrate:deploy": "cd ../../prisma/postgres && npx prisma migrate deploy",
    "db:seed": "cd ../../prisma/postgres && node seed.js",
    "db:studio": "cd ../../prisma/postgres && npx prisma studio",
    "db:generate": "cd ../../prisma/postgres && npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.4",
    "morgan": "^1.10.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.8.0",
    "supertest": "^6.3.3",
    "vitest": "^1.1.0"
  }
}
